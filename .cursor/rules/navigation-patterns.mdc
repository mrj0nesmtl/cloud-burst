## Navigation Architecture

Cloud Burst uses a structured navigation system consisting of several key components:

### 1. Primary Navigation Components

#### Sidebar Navigation

The sidebar provides the main navigation structure, organizing features into logical groups:

```tsx
// src/components/nav/side-nav.tsx
import { cn } from "@/lib/utils";
import { Button } from "@/components/ui/button";
import { 
  LucideIcon, 
  LayoutDashboard, 
  Calendar, 
  Users, 
  Image, 
  BarChart, 
  User, 
  Bell, 
  CreditCard 
} from "lucide-react";
import Link from "next/link";
import { usePathname } from "next/navigation";

interface NavItemProps {
  href: string;
  icon: LucideIcon;
  title: string;
  isActive?: boolean;
  isChild?: boolean;
  collapsed?: boolean;
}

function NavItem({
  href,
  icon: Icon,
  title,
  isActive,
  isChild,
  collapsed,
}: NavItemProps) {
  return (
    <Button
      asChild
      variant="ghost"
      className={cn(
        "w-full justify-start",
        isChild && "pl-8",
        isActive
          ? "bg-muted font-medium text-primary"
          : "font-normal text-muted-foreground",
        collapsed && "px-2 justify-center"
      )}
    >
      <Link href={href}>
        <Icon
          className={cn(
            "h-5 w-5",
            isActive ? "text-primary" : "text-muted-foreground",
            collapsed ? "mx-0" : "mr-2"
          )}
        />
        {!collapsed && <span>{title}</span>}
      </Link>
    </Button>
  );
}

interface NavGroupProps {
  title: string;
  children: React.ReactNode;
  collapsed?: boolean;
}

function NavGroup({ title, children, collapsed }: NavGroupProps) {
  return (
    <div className="space-y-1">
      {!collapsed && (
        <h3 className="px-3 text-xs font-semibold text-muted-foreground">
          {title}
        </h3>
      )}
      {children}
    </div>
  );
}

interface SideNavProps {
  collapsed?: boolean;
}

export function SideNav({ collapsed = false }: SideNavProps) {
  const pathname = usePathname();
  
  return (
    <nav className="space-y-6 px-2 py-4">
      <NavGroup title="Main" collapsed={collapsed}>
        <NavItem
          href="/protected/dashboard"
          icon={LayoutDashboard}
          title="Dashboard"
          isActive={pathname === "/protected/dashboard"}
          collapsed={collapsed}
        />

        <NavItem
          href="/protected/events"
          icon={Calendar}
          title="Events"
          isActive={pathname.startsWith("/protected/events")}
          collapsed={collapsed}
        />

        <NavItem
          href="/protected/attendees/manage"
          icon={Users}
          title="Attendees"
          isActive={pathname.startsWith("/protected/attendees")}
          collapsed={collapsed}
        />

        <NavItem
          href="/protected/gallery"
          icon={Image}
          title="Gallery"
          isActive={pathname.startsWith("/protected/gallery")}
          collapsed={collapsed}
        />

        <NavItem
          href="/protected/analytics/events"
          icon={BarChart}
          title="Analytics"
          isActive={pathname.startsWith("/protected/analytics")}
          collapsed={collapsed}
        />
      </NavGroup>

      <NavGroup title="Settings" collapsed={collapsed}>
        <NavItem
          href="/protected/settings/profile"
          icon={User}
          title="Profile"
          isActive={pathname === "/protected/settings/profile"}
          collapsed={collapsed}
        />

        <NavItem
          href="/protected/settings/notifications"
          icon={Bell}
          title="Notifications"
          isActive={pathname === "/protected/settings/notifications"}
          collapsed={collapsed}
        />

        <NavItem
          href="/protected/settings/subscription"
          icon={CreditCard}
          title="Subscription"
          isActive={pathname === "/protected/settings/subscription"}
          collapsed={collapsed}
        />
      </NavGroup>
    </nav>
  );
}
```

#### Topbar Navigation

The topbar provides contextual actions and global functionality:

```tsx
// src/components/nav/top-nav.tsx
import { Menu, Bell, User, Search } from "lucide-react";
import { Button } from "@/components/ui/button";
import { Logo } from "@/components/nav/logo";
import { UserNav } from "@/components/nav/user-nav";
import { ThemeToggle } from "@/components/theme-toggle";
import { Input } from "@/components/ui/input";

interface TopNavProps {
  onToggleSidebar: () => void;
  user: any;
  profile: any;
  onSignOut: () => void;
}

export function TopNav({ onToggleSidebar, user, profile, onSignOut }: TopNavProps) {
  return (
    <header className="flex h-16 items-center gap-4 border-b bg-background px-6">
      <Button
        variant="ghost"
        size="icon"
        className="lg:hidden"
        onClick={onToggleSidebar}
      >
        <Menu className="h-5 w-5" />
        <span className="sr-only">Toggle menu</span>
      </Button>
      
      <Logo />
      
      <div className="flex-1">
        <div className="relative max-w-md">
          <Search className="absolute left-2.5 top-2.5 h-4 w-4 text-muted-foreground" />
          <Input
            type="search"
            placeholder="Search..."
            className="w-full bg-background pl-8 md:w-64 lg:w-80"
          />
        </div>
      </div>
      
      <div className="flex items-center gap-2">
        <Button variant="ghost" size="icon">
          <Bell className="h-5 w-5" />
          <span className="sr-only">Notifications</span>
        </Button>
        
        <ThemeToggle />
        
        <UserNav user={user} profile={profile} onSignOut={onSignOut} />
      </div>
    </header>
  );
}
```

#### Breadcrumbs Navigation

Breadcrumbs provide hierarchical context:

```tsx
// src/components/ui/breadcrumbs.tsx
import { ChevronRight, Home } from "lucide-react";
import Link from "next/link";
import { cn } from "@/lib/utils";

export interface BreadcrumbItem {
  title: string;
  href?: string;
}

interface BreadcrumbsProps {
  items: BreadcrumbItem[];
  className?: string;
}

export function Breadcrumbs({ items, className }: BreadcrumbsProps) {
  return (
    <nav aria-label="Breadcrumbs" className={cn("flex items-center", className)}>
      <ol className="flex items-center space-x-2 text-sm">
        <li>
          <Link
            href="/"
            className="flex items-center text-muted-foreground hover:text-foreground"
          >
            <Home className="h-4 w-4" />
            <span className="sr-only">Home</span>
          </Link>
        </li>
        
        {items.map((item, index) => (
          <li key={index} className="flex items-center">
            <ChevronRight className="h-4 w-4 text-muted-foreground" />
            
            {item.href && index < items.length - 1 ? (
              <Link
                href={item.href}
                className="ml-2 text-muted-foreground hover:text-foreground"
              >
                {item.title}
              </Link>
            ) : (
              <span className="ml-2 font-medium text-foreground">
                {item.title}
              </span>
            )}
          </li>
        ))}
      </ol>
    </nav>
  );
}
```

### 2. Dashboard Layout Integration

The navigation components are integrated in a dashboard layout:

```tsx
// src/components/layout/dashboard-layout.tsx
import { useState, useEffect } from 'react';
import { usePathname } from 'next/navigation';
import { SideNav } from '@/components/nav/side-nav';
import { TopNav } from '@/components/nav/top-nav';
import { Breadcrumbs, BreadcrumbItem } from '@/components/ui/breadcrumbs';
import { X, Menu } from 'lucide-react';
import { Button } from '@/components/ui/button';
import { cn } from '@/lib/utils';

interface DashboardLayoutProps {
  children: React.ReactNode;
}

export function DashboardLayout({ children }: DashboardLayoutProps) {
  const pathname = usePathname();
  const [sidebarOpen, setSidebarOpen] = useState(false);
  const [sidebarCollapsed, setSidebarCollapsed] = useState(false);
  const [breadcrumbs, setBreadcrumbs] = useState<BreadcrumbItem[]>([]);
  
  // Handle ESC key to close sidebar
  useEffect(() => {
    const handleKeyDown = (e: KeyboardEvent) => {
      if (e.key === 'Escape') {
        setSidebarOpen(false);
      }
    };
    
    window.addEventListener('keydown', handleKeyDown);
    return () => window.removeEventListener('keydown', handleKeyDown);
  }, []);
  
  // Generate breadcrumbs from pathname
  useEffect(() => {
    const pathSegments = pathname.split('/').filter(Boolean);
    
    const items: BreadcrumbItem[] = pathSegments.map((segment, index) => {
      const href = '/' + pathSegments.slice(0, index + 1).join('/');
      return {
        title: segment.charAt(0).toUpperCase() + segment.slice(1).replace(/-/g, ' '),
        href,
      };
    });
    
    setBreadcrumbs(items);
    // Close mobile sidebar when navigating
    setSidebarOpen(false);
  }, [pathname]);
  
  return (
    <div className="flex min-h-screen">
      {/* Mobile sidebar overlay */}
      {sidebarOpen && (
        <div
          className="fixed inset-0 z-40 bg-background/80 backdrop-blur-sm lg:hidden"
          onClick={() => setSidebarOpen(false)}
        />
      )}
      
      {/* Mobile sidebar */}
      <div
        className={cn(
          "fixed inset-y-0 left-0 z-50 w-64 transform border-r bg-background transition-transform duration-300 ease-in-out lg:hidden",
          sidebarOpen ? "translate-x-0" : "-translate-x-full"
        )}
      >
        <div className="flex h-16 items-center justify-between border-b px-4">
          <span className="text-lg font-semibold">Cloud Burst</span>
          <Button
            variant="ghost"
            size="icon"
            onClick={() => setSidebarOpen(false)}
          >
            <X className="h-5 w-5" />
            <span className="sr-only">Close sidebar</span>
          </Button>
        </div>
        <SideNav collapsed={false} />
      </div>
      
      {/* Main content */}
      <div className="flex flex-1 flex-col">
        {/* Top navigation */}
        <TopNav
          onToggleSidebar={() => setSidebarOpen(true)}
          user={user}
          profile={profile}
          onSignOut={handleSignOut}
        />
        
        <div className="flex flex-1">
          {/* Desktop sidebar */}
          <div
            className={cn(
              "hidden border-r transition-all duration-300 ease-in-out lg:block",
              sidebarCollapsed ? "w-20" : "w-64"
            )}
          >
            <div className="sticky top-16 h-[calc(100vh-4rem)] overflow-y-auto py-6">
              <SideNav collapsed={sidebarCollapsed} />
              
              <div className="absolute bottom-4 right-4">
                <Button
                  variant="ghost"
                  size="icon"
                  onClick={() => setSidebarCollapsed(!sidebarCollapsed)}
                >
                  <Menu className="h-5 w-5" />
                  <span className="sr-only">
                    {sidebarCollapsed ? "Expand" : "Collapse"} sidebar
                  </span>
                </Button>
              </div>
            </div>
          </div>
          
          {/* Main content area */}
          <div className="flex-1 overflow-auto">
            <div className="container py-6">
              <Breadcrumbs items={breadcrumbs} className="mb-6" />
              {children}
            </div>
          </div>
        </div>
      </div>
    </div>
  );
}
```

### 3. Contextual Navigation

For specific feature areas, contextual navigation enhances the user experience:

#### Tab Navigation

```tsx
// src/components/ui/tabs-nav.tsx
import Link from "next/link";
import { usePathname } from "next/navigation";
import { cn } from "@/lib/utils";
import { LucideIcon } from "lucide-react";

interface TabItem {
  title: string;
  href: string;
  icon?: LucideIcon;
}

interface TabsNavProps {
  tabs: TabItem[];
  className?: string;
}

export function TabsNav({ tabs, className }: TabsNavProps) {
  const pathname = usePathname();
  
  return (
    <nav
      className={cn("flex space-x-2 border-b", className)}
      aria-label="Tabs"
    >
      {tabs.map((tab) => {
        const isActive = pathname === tab.href;
        const Icon = tab.icon;
        
        return (
          <Link
            key={tab.href}
            href={tab.href}
            className={cn(
              "flex items-center px-3 py-2 text-sm font-medium",
              isActive
                ? "border-b-2 border-primary text-primary"
                : "text-muted-foreground hover:text-foreground"
            )}
            aria-current={isActive ? "page" : undefined}
          >
            {Icon && <Icon className="mr-2 h-4 w-4" />}
            {tab.title}
          </Link>
        );
      })}
    </nav>
  );
}
```

#### Contextual Actions

```tsx
// src/components/ui/context-actions.tsx
import { Button } from "@/components/ui/button";
import { LucideIcon } from "lucide-react";
import { cn } from "@/lib/utils";

interface Action {
  title: string;
  icon?: LucideIcon;
  onClick: () => void;
  primary?: boolean;
  destructive?: boolean;
}

interface ContextActionsProps {
  actions: Action[];
  className?: string;
}

export function ContextActions({ actions, className }: ContextActionsProps) {
  return (
    <div className={cn("flex items-center space-x-2", className)}>
      {actions.map((action, index) => {
        const Icon = action.icon;
        
        return (
          <Button
            key={index}
            onClick={action.onClick}
            variant={
              action.destructive
                ? "destructive"
                : action.primary
                ? "default"
                : "outline"
            }
            size="sm"
          >
            {Icon && <Icon className="mr-2 h-4 w-4" />}
            {action.title}
          </Button>
        );
      })}
    </div>
  );
}
```

## Mobile Navigation

### Mobile Menu

For mobile devices, a responsive navigation system is implemented:

```tsx
// src/components/nav/mobile-nav.tsx
import { Sheet, SheetContent, SheetTrigger } from "@/components/ui/sheet";
import { Button } from "@/components/ui/button";
import { Menu } from "lucide-react";
import { SideNav } from "@/components/nav/side-nav";

export function MobileNav() {
  return (
    <Sheet>
      <SheetTrigger asChild>
        <Button variant="ghost" size="icon" className="lg:hidden">
          <Menu className="h-5 w-5" />
          <span className="sr-only">Open navigation menu</span>
        </Button>
      </SheetTrigger>
      <SheetContent side="left" className="p-0">
        <div className="p-6">
          <SideNav />
        </div>
      </SheetContent>
    </Sheet>
  );
}
```

## Navigation States

### Active State

The active state for navigation items is important for user orientation:

```tsx
// Example of active state styling
<Link
  href={href}
  className={cn(
    "flex items-center px-3 py-2 rounded-md text-sm font-medium transition-colors",
    pathname === href
      ? "bg-primary/10 text-primary"
      : "text-muted-foreground hover:bg-muted hover:text-foreground"
  )}
>
  {icon && <icon className="mr-2 h-4 w-4" />}
  {title}
</Link>
```

### Collapsed State

For the sidebar, a collapsed state improves space utilization:

```tsx
// Example of collapsed state handling
function SidebarItem({ icon, title, href, collapsed }) {
  return (
    <Link
      href={href}
      className="flex items-center py-2"
    >
      <span className="rounded-md p-2 bg-muted">
        {icon}
      </span>
      {!collapsed && (
        <span className="ml-3">{title}</span>
      )}
    </Link>
  );
}
```

## Accessibility Considerations

Navigation components must be accessible:

1. **Skip Links**: Provide skip links for keyboard users
2. **ARIA Attributes**: Use proper ARIA roles and labels
3. **Keyboard Navigation**: Ensure all navigation is keyboard accessible
4. **Focus Management**: Manage focus properly, especially in modals
5. **Screen Readers**: Provide appropriate announcements for page changes

```tsx
// Skip link implementation
function SkipLink() {
  return (
    <a
      href="#main-content"
