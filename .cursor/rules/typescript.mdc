---
description: TypeScript Standards for Cloud Burst
globs: **/*.ts", "**/*.tsx
alwaysApply: false
---
{
  "typeScriptRules": {
    "strictness": {
      "strict": true,
      "noImplicitAny": true,
      "strictNullChecks": true
    },
    "naming": {
      "interfaces": "I{Name}",
      "types": "T{Name}",
      "generics": "{T}Props"
    },
    "organization": {
      "types": {
        "shared": "src/types",
        "components": "alongside-component",
        "api": "src/types/api"
      }
    },
    "supabase": {
      "location": "src/types/supabase.ts",
      "generation": "automatic"
    },
    "zod": {
      "location": "src/lib/validations",
      "naming": "{name}.schema.ts"
    }
  }
}