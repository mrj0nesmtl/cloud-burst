Frontend Architecture Guidelines for Cloud Burst

{
  "description": "Frontend architecture guidelines for Cloud Burst, including React Components, State Management, and Accessibility",
  "globs": ["**/*.tsx", "**/*.jsx", "**/components/**", "**/hooks/**", "**/store/**", "**/styles/**"],
  "rules": {
    "reactComponents": {
      "architecture": {
        "useAtomicDesign": true,
        "componentTypes": ["atoms", "molecules", "organisms", "templates", "pages"],
        "separateClientServer": true,
        "useServerComponents": true,
        "useClientComponents": true
      },
      "structure": {
        "useDirectoryStructure": true,
        "colocateTests": true,
        "colocateStyles": true,
        "colocateTypes": true,
        "useIndexExports": true
      },
      "patterns": {
        "useComposition": true,
        "useRenderProps": true,
        "useHooks": true,
        "useContextAPI": true,
        "useMemo": true,
        "useCallback": true
      },
      "styling": {
        "useTailwind": true,
        "useShadcn": true,
        "useCSS": false,
        "useSass": false,
        "useStyledComponents": false,
        "useEmotionCSS": false
      },
      "layout": {
        "useConsistentLayout": true,
        "documentationPath": "docs/consistent-layout.md",
        "layoutStructure": {
          "outerContainer": "width: '100%', padding: '24px'",
          "headerContainer": "marginBottom: '24px'",
          "title": "fontSize: '24px', fontWeight: 'bold', marginBottom: '8px'",
          "description": "color: 'var(--muted-foreground)'"
        }
      }
    },
    "stateManagement": {
      // ... existing code ...
    },
    "accessibility": {
      // ... existing code ...
    }
  }
} 