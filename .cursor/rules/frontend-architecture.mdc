---
description: Frontend Architecture Guidelines for Cloud Burst
globs: **/*.tsx, **/*.jsx, **/components/**, **/hooks/**, **/store/**, **/styles/**
alwaysApply: false
---
{
  "description": "Frontend architecture guidelines for Cloud Burst, including React Components, State Management, and Accessibility",
  "globs": ["**/*.tsx", "**/*.jsx", "**/components/**", "**/hooks/**", "**/store/**", "**/styles/**"],
  "rules": {
    "reactComponents": {
      "architecture": {
        "useAtomicDesign": true,
        "componentTypes": ["atoms", "molecules", "organisms", "templates", "pages"],
        "separateClientServer": true,
        "useServerComponents": true,
        "useClientComponents": true
      },
      "structure": {
        "useDirectoryStructure": true,
        "colocateTests": true,
        "colocateStyles": true,
        "colocateTypes": true,
        "useIndexExports": true
      },
      "patterns": {
        "useComposition": true,
        "useRenderProps": true,
        "useHooks": true,
        "useContextAPI": true,
        "useMemo": true,
        "useCallback": true
      },
      "styling": {
        "useTailwind": true,
        "useShadcn": true,
        "useCSS": false,
        "useSass": false,
        "useStyledComponents": false,
        "useEmotionCSS": false
      }
    },
    "stateManagement": {
      "global": {
        "useZustand": true,
        "useContext": true,
        "useRedux": false,
        "useRecoil": false,
        "useJotai": false
      },
      "local": {
        "useState": true,
        "useReducer": true
      },
      "server": {
        "useTanStackQuery": true,
        "useSupabase": true,
        "useServerActions": true
      },
      "patterns": {
        "useSlices": true,
        "useSelectors": true,
        "useImmer": false,
        "useAtoms": false
      },
      "persistence": {
        "useLocalStorage": true,
        "useSessionStorage": true,
        "useCookies": true,
        "useSupabaseStorage": true
      }
    },
    "accessibility": {
      "standards": {
        "wcag": "2.1 AA",
        "aria": true,
        "semanticHTML": true,
        "keyboardNavigation": true,
        "screenReaders": true,
        "colorContrast": true,
        "reducedMotion": true,
        "focusManagement": true,
        "formLabels": true,
        "imageAlts": true,
        "tableHeaders": true
      },
      "testing": {
        "useAxe": true,
        "useJest": true,
        "useCypress": true,
        "usePlaywright": true,
        "useManualTesting": true,
        "useScreenReaderTesting": true
      },
      "components": {
        "useAccessibleForms": true,
        "useAccessibleNavigation": true,
        "useAccessibleModals": true,
        "useAccessibleTables": true,
        "useAccessibleImages": true,
        "useAccessibleButtons": true,
        "useAccessibleLinks": true,
        "useAccessibleTooltips": true,
        "useAccessibleDialogs": true,
        "useAccessibleMenus": true
      },
      "patterns": {
        "useSkipLinks": true,
        "useFocusTrap": true,
        "useAnnouncements": true,
        "useKeyboardShortcuts": true,
        "useResponsiveDesign": true,
        "useHighContrastMode": true,
        "useDarkMode": true
      }
    }
  }
}