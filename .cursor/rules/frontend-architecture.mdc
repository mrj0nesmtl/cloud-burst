---
description: Frontend Architecture Guidelines for Cloud Burst
globs: **/*.tsx, **/*.jsx, **/components/**, **/hooks/**, **/store/**, **/styles/**
alwaysApply: false
---
Frontend Architecture Guidelines for Cloud Burst

{
  "description": "Frontend architecture guidelines for Cloud Burst, including React Components, State Management, and Accessibility",
  "globs": ["**/*.tsx", "**/*.jsx", "**/components/**", "**/hooks/**", "**/store/**", "**/styles/**"],
  "rules": {
    "reactComponents": {
      "architecture": {
        "useAtomicDesign": true,
        "componentTypes": ["atoms", "molecules", "organisms", "templates", "pages"],
        "separateClientServer": true,
        "useServerComponents": true,
        "useClientComponents": true
      },
      "structure": {
        "useDirectoryStructure": true,
        "colocateTests": true,
        "colocateStyles": true,
        "colocateTypes": true,
        "useIndexExports": true
      },
      "patterns": {
        "useComposition": true,
        "useRenderProps": true,
        "useHooks": true,
        "useContextAPI": true,
        "useMemo": true,
        "useCallback": true
      },
      "styling": {
        "useTailwind": true,
        "useShadcn": true,
        "useCSS": false,
        "useSass": false,
        "useStyledComponents": false,
        "useEmotionCSS": false
      },
      "layout": {
        "useConsistentLayout": true,
        "documentationPath": "docs/consistent-layout.md",
        "layoutStructure": {
          "outerContainer": "width: '100%', padding: '24px'",
          "headerContainer": "marginBottom: '24px'",
          "title": "fontSize: '24px', fontWeight: 'bold', marginBottom: '8px'",
          "description": "color: 'var(--muted-foreground)'"
        }
      }
    },
    "stateManagement": {
      // ... existing code ...
    },
    "accessibility": {
      // ... existing code ...
    },
    "gallery": {
      "layout": {
        "masonry": {
          "useVirtualization": true,
          "useProgressiveLoading": true,
          "useIntersectionObserver": true,
          "useDynamicColumns": true
        },
        "filtering": {
          "useComposableFilters": true,
          "useMemoization": true,
          "useDebounce": true,
          "useQueryParams": true
        },
        "upload": {
          "useChunkedUploads": true,
          "useConcurrentUploads": true,
          "useProgressTracking": true,
          "useErrorRecovery": true
        }
      },
      "mobile": {
        "progressive": {
          "useSkeletonLoading": true,
          "useLazyLoading": true,
          "useImageOptimization": true,
          "usePrioritization": true
        },
        "offline": {
          "useServiceWorker": true,
          "useIndexedDB": true,
          "useSyncQueue": true,
          "useConflictResolution": true
        },
        "touch": {
          "useGestureHandlers": true,
          "useHapticFeedback": true,
          "useTouchOptimization": true,
          "useAccessibleInteractions": true
        }
      },
      "analytics": {
        "realtime": {
          "useWebSocket": true,
          "useDataAggregation": true,
          "useCaching": true,
          "useFallback": true
        },
        "visualization": {
          "useResponsiveCharts": true,
          "useThemeSupport": true,
          "useAccessibleGraphs": true,
          "useInteractivity": true
        },
        "export": {
          "useStreamProcessing": true,
          "useBackgroundTasks": true,
          "useProgressTracking": true,
          "useErrorHandling": true
        }
      }
    },
    "patterns": {
      "components": {
        "useAtomicDesign": true,
        "useComposition": true,
        "useHooks": true,
        "useMemoization": true
      },
      "state": {
        "useZustand": true,
        "useTanStackQuery": true,
        "useContextAPI": true,
        "useImmer": true
      },
      "performance": {
        "useDynamicImports": true,
        "useCodeSplitting": true,
        "usePreloading": true,
        "useCaching": true
      }
    },
    "optimization": {
      "images": {
        "useNextImage": true,
        "useBlurPlaceholders": true,
        "useProgressiveLoading": true,
        "useFormatOptimization": true
      },
      "javascript": {
        "useTreeShaking": true,
        "useBundleAnalysis": true,
        "useChunkOptimization": true,
        "useDependencyOptimization": true
      },
      "styles": {
        "useTailwindPurge": true,
        "useCSSModules": true,
        "useAtomicCSS": true,
        "useStyleOptimization": true
      }
    }
  }
} 