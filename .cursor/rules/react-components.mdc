---
description: React Component Standards for Cloud Burst
globs: src/**/*.tsx", "src/**/*.ts
alwaysApply: false
---
{
  "componentRules": {
    "structure": {
      "atomic": {
        "atoms": "src/components/ui",
        "molecules": "src/components/common",
        "organisms": "src/components/features",
        "templates": "src/components/layouts",
        "pages": "src/app"
      }
    },
    "patterns": {
      "preferred": {
        "stateManagement": "zustand",
        "styling": "tailwind",
        "forms": "react-hook-form",
        "validation": "zod",
        "auth": "@supabase/auth-helpers-nextjs",
        "media": {
          "images": "next/image",
          "video": "static-optimized"
        }
      }
    },
    "layout": {
      "bestPractices": {
        "useFullWidthWrapper": true,
        "avoidNestedContainers": true,
        "explicitDimensions": true,
        "simplifyForConflicts": true,
        "usePaddingConsistently": true
      },
      "troubleshooting": {
        "layoutConflicts": "When experiencing layout conflicts, simplify the component hierarchy and eliminate nested containers",
        "cssOverflow": "Use explicit width control with w-full on parent containers to prevent unexpected overflow",
        "renderIssues": "For persistent layout issues, consider using inline styles with style={{}} temporarily to bypass CSS conflicts",
        "responsiveBreakage": "Test layout fixes across all breakpoints to ensure responsiveness is maintained"
      },
      "fallbackPatterns": {
        "inlineStylesFallback": "src/app/protected/dashboard/page.tsx, src/app/protected/qr-codes/page.tsx",
        "directStyleControl": "Use direct style control with style={{}} when Tailwind classes cause conflicts",
        "flattenHierarchy": "Remove unnecessary wrapper divs to reduce CSS inheritance conflicts",
        "dimensionControl": "Always specify width: 100% on main content containers"
      }
    },
    "shadcn": {
      "location": "src/components/ui",
      "themes": {
        "default": "zinc",
        "dark": "true"
      },
      "customComponents": {
        "location": "src/components/ui/custom",
        "naming": "[ComponentName].tsx"
      }
    },
    "performance": {
      "suspense": true,
      "lazyLoading": {
        "images": true,
        "components": ["GalleryGrid", "EventMap"]
      }
    },
    "gallery": {
      "components": {
        "GalleryGrid": {
          "type": "organism",
          "features": ["masonry", "virtualization", "lazyLoading"],
          "props": {
            "photos": "Photo[]",
            "layout": "'grid' | 'masonry' | 'list'",
            "onPhotoSelect": "(photo: Photo) => void",
            "onPhotoAction": "(action: PhotoAction, photo: Photo) => void"
          }
        },
        "PhotoCard": {
          "type": "molecule",
          "features": ["preview", "actions", "metadata"],
          "props": {
            "photo": "Photo",
            "variant": "'grid' | 'list' | 'detail'",
            "actions": "PhotoAction[]"
          }
        },
        "UploadZone": {
          "type": "organism",
          "features": ["dragDrop", "multiUpload", "progress"],
          "props": {
            "onUpload": "(files: File[]) => Promise<void>",
            "maxSize": "number",
            "acceptedTypes": "string[]"
          }
        }
      },
      "optimizations": {
        "useVirtualization": true,
        "useLazyLoading": true,
        "useImageOptimization": true,
        "useProgressiveLoading": true
      }
    },
    "analytics": {
      "components": {
        "AnalyticsChart": {
          "type": "organism",
          "features": ["responsive", "interactive", "exportable"],
          "props": {
            "data": "ChartData",
            "type": "'line' | 'bar' | 'pie'",
            "options": "ChartOptions"
          }
        },
        "MetricCard": {
          "type": "molecule",
          "features": ["comparison", "trend", "sparkline"],
          "props": {
            "metric": "Metric",
            "comparison": "Comparison",
            "trend": "Trend"
          }
        },
        "DataTable": {
          "type": "organism",
          "features": ["sorting", "filtering", "pagination"],
          "props": {
            "data": "TableData",
            "columns": "Column[]",
            "options": "TableOptions"
          }
        }
      }
    },
    "mobile": {
      "components": {
        "BottomNav": {
          "type": "organism",
          "features": ["swipeable", "badges", "animations"],
          "props": {
            "items": "NavItem[]",
            "activeItem": "string",
            "onItemSelect": "(item: NavItem) => void"
          }
        },
        "SwipeableView": {
          "type": "molecule",
          "features": ["gestures", "animations", "indicators"],
          "props": {
            "items": "ViewItem[]",
            "currentIndex": "number",
            "onSwipe": "(direction: 'left' | 'right') => void"
          }
        },
        "PullToRefresh": {
          "type": "molecule",
          "features": ["customIndicator", "resistance", "completion"],
          "props": {
            "onRefresh": "() => Promise<void>",
            "threshold": "number",
            "resistance": "number"
          }
        }
      },
      "optimizations": {
        "useTouchEvents": true,
        "useNativeScrolling": true,
        "useVirtualization": true,
        "usePrefetching": true
      }
    }
  }
}