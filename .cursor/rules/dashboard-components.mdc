# Dashboard Component Standards for Cloud Burst

> **Version:** 0.8.0  
> **Last Updated:** March 18, 2025  
> **Related to:** Session 27 - Gallery Enhancement & Analytics Integration

```json
{
  "description": "Dashboard component standards for Cloud Burst, including section layouts, cards, data visualization, and specialized components for the event organizer dashboard",
  "globs": ["**/dashboard/**", "**/protected/**"],
  "rules": {
    "dashboardStructure": {
      "sectioning": {
        "usePrimarySection": true,
        "useSecondarySection": true,
        "useFullWidthLayout": true,
        "useResponsiveColumn": true,
        "useDividers": true,
        "useMobileOptimization": true,
        "useGalleryLayout": true,
        "useAnalyticsLayout": true
      },
      "components": {
        "useStatCard": true,
        "useActivityFeed": true,
        "useQuickActions": true,
        "useEventList": true,
        "useCalendarView": true,
        "useDataTable": true,
        "useFileGrid": true,
        "useGalleryGrid": true,
        "useAnalyticsCharts": true,
        "useMobileNav": true
      },
      "layout": {
        "maxSections": 4,
        "gridGap": "1.5rem",
        "sectionPadding": "1.5rem",
        "cardPadding": "1rem",
        "mobileSpacing": "1rem",
        "breakpoints": {
          "mobile": "640px",
          "tablet": "768px",
          "desktop": "1024px",
          "wide": "1280px",
          "gallery": "1536px"
        }
      }
    },
    "cardComponents": {
      "variants": {
        "standard": "Default card with border and white background",
        "highlight": "Card with accent border and subtle background color",
        "metric": "Card for displaying a single key metric",
        "action": "Interactive card with hover and press states",
        "gallery": "Card optimized for photo display",
        "analytics": "Card for data visualization"
      },
      "structure": {
        "header": {
          "required": true,
          "includeIcon": true,
          "includeTitle": true,
          "includeActions": true,
          "includeMobileMenu": true
        },
        "body": {
          "required": true,
          "paddingTop": "0.5rem",
          "paddingBottom": "0.5rem",
          "mobileOptimized": true
        },
        "footer": {
          "required": false,
          "includeAction": true,
          "includeMetadata": true,
          "includeShare": true
        }
      },
      "interactivity": {
        "useHoverState": true,
        "usePressState": true,
        "useFocusRing": true,
        "useContextMenu": true,
        "useGestures": true,
        "useDragDrop": true
      }
    },
    "dataVisualization": {
      "charts": {
        "preferred": "recharts",
        "types": ["bar", "line", "pie", "area", "scatter", "radar"],
        "accessibility": {
          "useAltText": true,
          "useAriaLabels": true,
          "useDataTable": true,
          "useKeyboardNav": true,
          "useColorBlindMode": true
        },
        "theming": {
          "useSystemColors": true,
          "useLightDarkTokens": true,
          "useColorBlindSafe": true,
          "useCustomPalettes": true
        },
        "interaction": {
          "useTooltips": true,
          "useZoom": true,
          "usePan": true,
          "useSelection": true,
          "useExport": true
        }
      },
      "dataDisplay": {
        "emptyState": {
          "required": true,
          "includeIllustration": true,
          "includeMessage": true,
          "includeAction": true,
          "mobileOptimized": true
        },
        "loading": {
          "useSkeletonLoader": true,
          "useProgressIndicator": true,
          "retainLayout": true,
          "useShimmer": true
        },
        "error": {
          "includeMessage": true,
          "includeRetry": true,
          "preserveLayout": true,
          "useOfflineIndicator": true
        },
        "pagination": {
          "itemsPerPage": [10, 25, 50, 100],
          "defaultItems": 25,
          "useInfiniteScroll": true,
          "usePageNavigation": true,
          "useMobileOptimized": true
        }
      }
    },
    "dashboardNavigation": {
      "structure": {
        "useSidebar": true,
        "useTopBar": true,
        "useBreadcrumbs": true,
        "useContextualActions": true,
        "useBottomNav": true,
        "useGestures": true
      },
      "sidebarSections": [
        "Overview",
        "Events",
        "Attendees",
        "Gallery",
        "Analytics",
        "Settings"
      ],
      "breadcrumbs": {
        "maxDepth": 3,
        "includeHome": true,
        "truncateMiddle": true,
        "mobileCollapse": true
      },
      "contextualNavigation": {
        "useTabNavigation": true,
        "useSteppers": true,
        "useWizard": true,
        "useGestures": true
      }
    },
    "specializedDashboardComponents": {
      "gallery": {
        "photoGrid": {
          "viewOptions": ["grid", "masonry", "list", "carousel"],
          "selectableItems": true,
          "dragAndDrop": true,
          "supportFilters": true,
          "supportSorting": true,
          "supportSearch": true,
          "supportBulkActions": true,
          "supportSharing": true
        },
        "photoCard": {
          "displayPreview": true,
          "displayMetadata": true,
          "displayLikes": true,
          "displayDownload": true,
          "displayActions": true,
          "supportGestures": true,
          "supportZoom": true,
          "supportShare": true
        },
        "albumsList": {
          "displayTitle": true,
          "displayCover": true,
          "displayCount": true,
          "displayDate": true,
          "displayActions": true,
          "supportDragDrop": true,
          "supportReorder": true
        }
      },
      "analytics": {
        "metricsDisplay": {
          "realTimeUpdates": true,
          "historicalData": true,
          "comparisonView": true,
          "trendAnalysis": true,
          "exportOptions": true,
          "customization": true
        },
        "dashboards": {
          "layouts": ["grid", "list", "custom"],
          "widgets": ["chart", "metric", "table", "list"],
          "customization": true,
          "sharing": true,
          "export": true
        },
        "reports": {
          "templates": true,
          "scheduling": true,
          "formats": ["pdf", "csv", "json"],
          "customization": true,
          "automation": true
        }
      },
      "mobile": {
        "navigation": {
          "useBottomNav": true,
          "useGestures": true,
          "usePullToRefresh": true,
          "useSwipeActions": true
        },
        "optimization": {
          "useLazyLoading": true,
          "useProgressiveLoading": true,
          "useOfflineSupport": true,
          "useNetworkAware": true
        },
        "interaction": {
          "useGestures": true,
          "useHaptics": true,
          "useShareAPI": true,
          "usePushNotifications": true
        }
      }
    }
  }
}
```