### Performance Optimization Example

```typescript
// components/PhotoGallery.tsx
'use client'

import { useState, useCallback, useRef, useEffect } from 'react';
import { useInView } from 'react-intersection-observer';
import { useQuery } from '@tanstack/react-query';
import { PhotoCard } from './PhotoCard';
import { Spinner } from './ui/Spinner';
import { fetchPhotos } from '@/lib/api';

interface PhotoGalleryProps {
  eventId: string;
}

export function PhotoGallery({ eventId }: PhotoGalleryProps) {
  const [page, setPage] = useState(1);
  const [allPhotos, setAllPhotos] = useState<Photo[]>([]);
  const hasMore = useRef(true);
  
  const { ref, inView } = useInView();
  
  const { data, isLoading, isFetching } = useQuery({
    queryKey: ['photos', eventId, page],
    queryFn: () => fetchPhotos(eventId, page),
    keepPreviousData: true,
    staleTime: 5 * 60 * 1000, // 5 minutes
  });
  
  useEffect(() => {
    if (data) {
      setAllPhotos((prev) => [...prev, ...data.photos]);
      hasMore.current = data.hasMore;
    }
  }, [data]);
  
  useEffect(() => {
    if (inView && hasMore.current && !isFetching) {
      setPage((prev) => prev + 1);
    }
  }, [inView, isFetching]);
  
  if (isLoading && page === 1) {
    return <Spinner />;
  }
  
  return (
    <div className="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
      {allPhotos.map((photo) => (
        <PhotoCard key={photo.id} photo={photo} />
      ))}
      
      {hasMore.current && (
        <div ref={ref} className="flex justify-center p-4">
          <Spinner />
        </div>
      )}
    </div>
  );
}
```

### Error Handling Example

```typescript
// hooks/usePhotoUpload.ts
'use client'

import { useState } from 'react';
import { useToast } from '@/hooks/useToast';
import { uploadPhoto } from '@/lib/api';

export function usePhotoUpload() {
  const [isUploading, setIsUploading] = useState(false);
  const [progress, setProgress] = useState(0);
  const { toast } = useToast();
  
  const upload = async (file: File, eventId: string) => {
    setIsUploading(true);
    setProgress(0);
    
    try {
      const onProgress = (percent: number) => {
        setProgress(percent);
      };
      
      const result = await uploadPhoto(file, eventId, onProgress);
      
      toast({
        title: 'Success',
        description: 'Photo uploaded successfully',
        variant: 'success',
      });
      
      return result;
    } catch (error) {
      console.error('Photo upload error:', error);
      
      toast({
        title: 'Upload Failed',
        description: error instanceof Error ? error.message : 'Failed to upload photo',
        variant: 'destructive',
      });
      
      throw error;
    } finally {
      setIsUploading(false);
    }
  };
  
  return {
    upload,
    isUploading,
    progress,
  };
}
``` 