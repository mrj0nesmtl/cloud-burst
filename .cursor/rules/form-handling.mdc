## Form Handling Architecture

Cloud Burst uses React Hook Form with Zod for form validation and submission handling. This architecture provides a consistent, type-safe, and accessible approach to form implementation across the platform.

### Basic Form Structure

Every form follows this pattern:

```tsx
// Example form structure
import { useForm } from "react-hook-form";
import { zodResolver } from "@hookform/resolvers/zod";
import { z } from "zod";
import { Button } from "@/components/ui/button";
import { Form, FormControl, FormField, FormItem, FormLabel, FormMessage } from "@/components/ui/form";
import { Input } from "@/components/ui/input";

// 1. Define the schema
const formSchema = z.object({
  name: z.string().min(2, "Name must be at least 2 characters"),
  email: z.string().email("Please enter a valid email address"),
});

// 2. Define the form types
type FormValues = z.infer<typeof formSchema>;

export function ExampleForm() {
  // 3. Initialize the form
  const form = useForm<FormValues>({
    resolver: zodResolver(formSchema),
    defaultValues: {
      name: "",
      email: "",
    },
  });

  // 4. Define the submission handler
  const onSubmit = async (values: FormValues) => {
    try {
      // Handle form submission
      console.log(values);
    } catch (error) {
      // Handle errors
      console.error(error);
    }
  };

  // 5. Render the form
  return (
    <Form {...form}>
      <form onSubmit={form.handleSubmit(onSubmit)} className="space-y-4">
        <FormField
          control={form.control}
          name="name"
          render={({ field }) => (
            <FormItem>
              <FormLabel>Name</FormLabel>
              <FormControl>
                <Input {...field} />
              </FormControl>
              <FormMessage />
            </FormItem>
          )}
        />
        
        <FormField
          control={form.control}
          name="email"
          render={({ field }) => (
            <FormItem>
              <FormLabel>Email</FormLabel>
              <FormControl>
                <Input {...field} type="email" />
              </FormControl>
              <FormMessage />
            </FormItem>
          )}
        />
        
        <Button type="submit" disabled={form.formState.isSubmitting}>
          {form.formState.isSubmitting ? "Submitting..." : "Submit"}
        </Button>
      </form>
    </Form>
  );
}
```

### Form State Management

Forms should properly handle all states:

#### Loading State

```tsx
// Example of a form with loading state
<Button type="submit" disabled={form.formState.isSubmitting}>
  {form.formState.isSubmitting ? (
    <>
      <Loader2 className="mr-2 h-4 w-4 animate-spin" />
      Submitting...
    </>
  ) : (
    "Submit"
  )}
</Button>
```

#### Error State

```tsx
// Example of form error handling
const [apiError, setApiError] = useState<string | null>(null);

const onSubmit = async (values: FormValues) => {
  try {
    setApiError(null);
    // API submission logic
  } catch (error) {
    // Handle API errors
    setApiError("Failed to submit form. Please try again.");
  }
};

// In the form component
{apiError && (
  <div className="bg-red-50 p-4 rounded-md border border-red-200 text-red-800 mb-4">
    <AlertTriangle className="h-4 w-4 inline-block mr-2" />
    {apiError}
  </div>
)}
```

#### Success State

```tsx
// Example of form success handling
const [isSuccess, setIsSuccess] = useState(false);

const onSubmit = async (values: FormValues) => {
  try {
    // API submission logic
    setIsSuccess(true);
    
    // Optional: Reset form
    form.reset();
    
    // Optional: Redirect user
    // router.push("/success-page");
  } catch (error) {
    setIsSuccess(false);
    // Error handling
